{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skerry",
  "version": "1.6.5",
  "identifier": "com.ahmad-maqsood.skerry",
  "build": {
    "beforeDevCommand": "node scripts/stop-running-island.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Skerry",
        "width": 820,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "translation",
        "title": "Skerry Translation",
        "url": "index.html?window=translation",
        "width": 480,
        "height": 640,
        "minWidth": 480,
        "minHeight": 380,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "clipboard",
        "create": false,
        "title": "Skerry",
        "url": "index.html?window=clipboard",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": false
      },
      {
        "label": "settings",
        "create": false,
        "title": "Skerry",
        "url": "index.html?window=settings",
        "width": 800,
        "height": 660,
        "minWidth": 560,
        "minHeight": 420,
        "center": true,
        "resizable": true,
        "backgroundColor": "#17191d"
      },
      {
        "label": "widget-clock",
        "create": false,
        "title": "Skerry Clock",
        "url": "index.html?window=widget-clock",
        "width": 560,
        "height": 230,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/ahmad-maqsood/skerry-island/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {},
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "nsis/installer-hooks.nsh",
        "languages": [
          "English"
        ]
      },
      "wix": {
        "language": "en-US"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "GPL-3.0-only",
    "licenseFile": "../LICENSE"
  }
}
